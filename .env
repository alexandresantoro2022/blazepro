# Configurações do Banco de Dados
DATABASE_URL=sqlite:///./delivery.db
# Para produção use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost/delivery_db

# Configurações de Segurança
SECRET_KEY=your-secret-key-here-change-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Configurações da Aplicação
APP_NAME=Delivery System
APP_VERSION=1.0.0
DEBUG=True

# Configurações de Email (para notificações)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Configurações de Pagamento (Stripe)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Configurações de Upload (AWS S3)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_BUCKET_NAME=delivery-system-uploads
AWS_REGION=us-east-1

# Configurações de Redis (para cache e filas)
REDIS_URL=redis://localhost:6379/0

# Configurações de Geolocalização
GOOGLE_MAPS_API_KEY=your-google-maps-api-key